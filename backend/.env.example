# Copy to backend/.env  (never commit the real .env)
# Leave both blank to run on the in-memory demo store (no database needed).
# Use the *service_role* key (Project Settings -> API) and run supabase/schema.sql first.
# Warning: POST /api/v1/simulate/reset deletes rows in the live demo tables.
SUPABASE_URL= 
SUPABASE_KEY= 
GEMINI_API_KEY=
# gemini-1.5-flash was retired by Google; use a current Flash model
GEMINI_MODEL=gemini-3.8-flash
VOID_THRESHOLD=0.75
# POS ingestion
DEFAULT_STORE_ID=store_01
INGEST_CHUNK_SIZE=500
CORS_ORIGINS=["http://localhost:3000"]
